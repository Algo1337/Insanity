class Configuration:
    ServerName          : str = ""

    """ Command Prefix """
    Prefix              : str = "+"

    """ Users Blacklisted """
    BlacklistedSkids    : list = []
    """ Blacklisted Tokens """
    BlacklistedTokens   : list = []
    """ Whitlisted Users """
    Whitlisted          : list = []
    """ Whitlisted Admin """
    WhitlistedAdmins    : list = []

    """ Log Channel | 1 Channel, All Logs """
    JoinChannel         : int | str = 0
    LogChannel          : int | str = 0

    LastMessage         : DiscordUtils = None
    LastDeleted         : DiscordUtils = None

    """ Watch VC Attacks """
    WatchVC             : bool = False
    CurrentVC           : str = ""
    CurrentRegion       : str = ""
    LastRegion          : str = ""          # Ensure watcher does not use the last region again

