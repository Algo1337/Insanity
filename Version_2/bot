    async def on_ready(self):
        await self.change_presence(
            status = discord.Status.dnd,
            activity = discord.Streaming(name = "Insanity Bot", url = "https://insanity.bot")
        )

        print(f"[ + ] Firing up {self.user}....!")

    def setup_bs(self, cmds_dir: str) -> None:
        self.Config = Configuration()
        self.Config.ServerName = "Skidville"

        self.Servers = {}
        self.Servers[self.CreatorServerID] = self.Config

        self.Cogs = dCog(cmds_dir)
        for cog in self.Cogs.Commands:
            if cog.NAME == "__on_message__": self.OnMessage = cog
            elif cog.NAME == "__on_message_delete__": self.OnMessageDeleted = cog
            elif cog.NAME == "__on_join__": self.OnJoin = cog

    """
        [ On Join ]
    """
    async def on_guild_join(self, guild):
        event = DiscordUtils(self, guild, Discord_Event_T.e_joined)
        event.log(Discord_Event_T.e_joined, "New Member Joined", {
            "User": [event.Client.author.name, True],
            "Display Name": [event.Client.author.display_name, True],
            "ID": [event.Client.author.id, True]
        })
        print(f"[ + ] Join {guild.id}")

    async def on_guild_leave(self, guild):
        event = DiscordUtils(self, guild, Discord_Event_T.e_left)
        event.log(Discord_Event_T.e_left, "New Member Joined", {
            "User": [event.Client.author.name, True],
            "Display Name": [event.Client.author.display_name, True],
            "ID": [event.Client.author.id, True]
        })
        print(f"[ + ] Join {guild.id}")
        
    async def on_member_join(self, member):
        msg = DiscordUtils(self, member, Discord_Event_T.e_joined)
        if self.OnJoin:
            if self.OnJoin.PASS_BASE:
                if (await self.OnJoin.CMD_HANDLER(self, msg)) == False:
                    return
                
            else:
                if (await self.OnJoin.CMD_HANDLER(msg)) == False:
                    return

    """
        [ On Message Delete ]
    """
    async def on_message_delete(self, message):
        msg = DiscordUtils(self, message, Discord_Event_T.e_message_del)
        msg.set_log_channel(1429855130081165364)

        if self.OnMessageDeleted:
            if self.OnMessageDeleted.PASS_BASE:
                if (await self.OnMessageDeleted.CMD_HANDLER(self, msg)) == False:
                    return
                
            else:
                if (await self.OnMessageDeleted.CMD_HANDLER(msg)) == False:
                    return
                

    async def on_message(self, message):
        """ Message Info """
        local_tz = pytz.timezone('America/Kentucky/Louisville')
        timestamp = message.created_at.replace(tzinfo=timezone.utc).astimezone(local_tz).strftime('%m-%d-%Y-%H:%M:%S')
        msg_id = message.id
        server_name = message.guild.name
        server_id = message.guild.id
        channel_name = message.channel.name
        channel_id = message.channel.id
        display_name = message.author.display_name
        username = message.author.name
        userid = message.author.id

        database(dbs_t.__MESSAGE_LOGS__, ops_t.__add_row__, f"('{timestamp}','{msg_id}','{server_name}({server_id})','{channel_name}({channel_id})','{username}({userid}-{display_name})','{message.content}')")

        if message.author == self.user:
            return
        
        """ Check for Server Config Or Add One """
        if message.guild.id != self.CreatorServerID and message.guild.id not in self.Servers:
            self.Servers[message.guild.id] = Configuration()
            self.Servers[message.guild.id].ServerName = message.guild.name

        """ Load Server Config """
        if message.guild.id in self.Servers:
            cfg = self.Servers[message.guild.id]

        """ Message Info """
        msg = DiscordUtils(self, message, Discord_Event_T.e_message)
        msg.set_log_channel(self.CreatorLogID)
        
        """ dCog OnMessage Handler """
        if self.OnMessage:
            if self.OnMessage.PASS_BASE:
                if (await self.OnMessage.CMD_HANDLER(self, msg)) == False:
                    return
                
            else:
                if (await self.OnMessage.CMD_HANDLER(msg)) == False:
                    return
                
        """ dCog Command Handler """
        for cmd in self.Cogs.Commands:
            if cmd.NAME.startswith("__"):
                continue
            
            if f"{self.Config.Prefix}{cmd.NAME}" == msg.Cmd and cmd.ARG_COUNT == 0:
                if cmd.PASS_BASE != False and cmd.PASS_BASE != None:
                    await cmd.CMD_HANDLER(self, msg)
                else:
                    await cmd.CMD_HANDLER(msg)

                break

            if f"{self.Config.Prefix}{cmd.NAME}" == msg.Cmd:
                if cmd.ARG_COUNT > 0 and msg.Args.__len__() < cmd.ARG_COUNT:
                    if isinstance(cmd.INFO["Invalid_Arg_Err"], discord.Embed):
                        await message.channel.send(embed = cmd.INFO["Invalid_Arg_Err"])
                        break

                    await message.channel.send(cmd.INFO["Invalid_Arg_Err"])
                    break
                else:
                    if cmd.PASS_BASE != None:
                        await cmd.CMD_HANDLER(self, msg)
                    else:
                        await cmd.CMD_HANDLER(msg)
    
    def find_server_config(self, server_q: int | str) -> Configuration:
        for server in self.Servers:
            if isinstance(server_q, int) and server == server_q:
                return self.Servers[server]
            
            if isinstance(server_q, str) and server == self.Servers[server].ServerName:
                return self.Servers[server]
            
        return None

